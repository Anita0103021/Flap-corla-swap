{
  "dependencies": {
    "ethers": "6.17.0"
  },
  "name": "corla-mint-tool",
  "version": "0.1.0",
  "type": "module",
  "description": "Local Flap Corla BSC mint, claim and launch monitor",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/cli.mjs",
